    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candela captures system audio so it can change the volume of HDMI and DisplayPort monitor speakers that have no hardware slider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candela 会采集系统音频，以便调节没有硬件滑块的 HDMI 和 DisplayPort 显示器扬声器音量。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candela needs Screen Recording to mirror a display in Picture in Picture and to apply software volume to HDMI and DisplayPort monitor speakers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candela 需要屏幕录制权限，才能在 Picture in Picture 中镜像显示器，并为 HDMI 和 DisplayPort 显示器扬声器应用软件音量。"
          }
        }
      }
    }
  },
  "version" : "1.0"
